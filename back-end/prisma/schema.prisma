generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PetType {
  GATO
  CACHORRO
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  
  pets      Pet[]

  @@map("users")
}

model Pet {
  id          String   @id @default(uuid())
  name        String
  age         Int
  type        PetType
  breed       String   // Raça
  ownerName   String   // Nome do dono (humano)
  ownerContact String  // Contato do dono (humano)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  images    PetImage[]
  @@map("pets")
}

model PetImage {
  id        String   @id @default(uuid())
  url       String   // Caminho do arquivo ou link do S3
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("pet_images")
}