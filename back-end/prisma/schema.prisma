generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PetType {
  GATO
  CACHORRO
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  
  pets      Pet[]

  @@map("users")
}

model Pet {
  id          String   @id @default(uuid())
  name        String
  age         Int
  type        PetType
  breed       String   // Raça
  ownerName   String   // Nome do dono (humano)
  ownerContact String  // Contato do dono (humano)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@map("pets")
}